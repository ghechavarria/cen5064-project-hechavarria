# Copy to .env (it stays on your computer: .env is in .gitignore). Both settings are optional.

# A free Google Books API key (Google Cloud console > APIs > Books API).
# Without it the app still works, using Open Library only.
EXPO_PUBLIC_GOOGLE_BOOKS_KEY=

# Accounts and library sync (ADR-012). Leave these empty to use the shared MyHomeLib
# project built into the app. To use your own Supabase project instead, set its Project URL
# and its Publishable key. Never put the secret or service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Copy to .env (it stays on your computer: .env is in .gitignore).

# Optional: a free Google Books API key (Google Cloud console > APIs > Books API).
# Without it the app still works, using Open Library only.
EXPO_PUBLIC_GOOGLE_BOOKS_KEY=

# Optional: accounts and library sync (ADR-012). From your Supabase project:
# Project Settings > Data API > Project URL, and Project Settings > API Keys > Publishable key
# (the older anon key also works). Never put the service_role or secret key here.
# Without these the app works on this device only, with no sign-in.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

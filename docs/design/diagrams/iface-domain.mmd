classDiagram
    direction LR
    class PersonalLibrary {
        +has(isbn) boolean
        +addBook(book)
        +get(isbn) Book
        +remove(isbn)
        +booksOn(shelf, status) Book[]
    }
    class Book {
        -copyCount: int
        -shelf: Shelf
        -readingStatus: ReadingStatus
        -format: BookFormat
        +addCopy()
        +acquire(record)
        +moveTo(shelf)
        +setReadingStatus(status)
        +changeCover(url)
        +fillFacts(facts)
    }
    class AcquisitionRecord {
        <<abstract>>
        +isComplete()* boolean
        +describe()* String
        +restore(kind, giftedBy)$
    }
    class Gift {
        -giver: String
    }
    PersonalLibrary "1" *-- "*" Book
    Book "1" *-- "0..1" AcquisitionRecord
    Purchase --|> AcquisitionRecord
    Gift --|> AcquisitionRecord

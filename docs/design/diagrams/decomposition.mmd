    subgraph S ["service/ (Service tier)"]
        direction LR
        uc["UseCases<br/>LoadLibrary · LookupIsbn · ScanBook<br/>MoveBookToShelf · SetReadingStatus<br/>ChangeCover · DeleteBook · FillMissingFacts"]

flowchart TB
    subgraph P ["presentation/ (Presentation tier)"]
        views["components/<br/>screens and widgets"]
        vm["model/<br/>LibraryAppModel<br/>LibraryController"]
        dev["device/<br/>PhoneDevices<br/>BrowserDevices"]
        sty["styles/<br/>theme + one stylesheet<br/>per component"]
    end
    subgraph S ["service/ (Service tier)"]
        uc["use cases<br/>8 classes, built by UseCases"]
        ports["ports.ts<br/>BookRepository · IsbnCache<br/>IsbnLookup"]
    end
    subgraph D ["domain/ (Domain tier)"]
        dm["Book · PersonalLibrary<br/>AcquisitionRecord<br/>(Purchase / Gift) · Isbn"]
    end
    subgraph DA ["data/ (Data tier)"]
        repo["repositories<br/>Sqlite · Json · Memory<br/>BookRowMapper"]
        src["book sources<br/>Open Library · Google Books<br/>Merged · Caching · Http"]
    end
    root["bootstrap.ts<br/>CompositionRoot"]
    views --> vm
    views --> sty
    dev -. implements .-> vm
    vm --> uc
    uc --> dm
    uc --> ports
    repo -. implements .-> ports
    src -. implements .-> ports
    root --> repo
    root --> src
    root --> uc

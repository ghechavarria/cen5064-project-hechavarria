classDiagram
    direction LR
    class BookRepository {
        <<interface>>
        +loadLibrary(ownerId) PersonalLibrary
        +save(ownerId, book) Book
        +delete(ownerId, isbn)
    }
    class IsbnCache {
        <<interface>>
        +cachedIsbn(isbn) BookMetadata
        +cacheIsbn(metadata)
    }
    class SyncStore {
        <<interface>>
        +versions(ownerId) BookVersion[]
        +applyVersions(ownerId, versions)
    }
    class BookRowMapper {
        +toBook(row)$ Book
        +toRow(ownerId, book, updatedAt, deletedAt)$ BookRow
        +toVersion(row)$ BookVersion
        +fromVersion(ownerId, version)$ BookRow
        +withDefaults(row)$ BookRow
        +isUsable(row)$ boolean
        +coverList(stored)$ String[]
    }
    SqliteBookRepository ..|> BookRepository
    MemoryBookRepository ..|> BookRepository
    JsonBookRepository ..|> BookRepository
    SqliteBookRepository ..|> IsbnCache
    MemoryBookRepository ..|> IsbnCache
    JsonBookRepository ..|> IsbnCache
    SqliteBookRepository ..|> SyncStore
    MemoryBookRepository ..|> SyncStore
    JsonBookRepository ..|> SyncStore
    JsonBookRepository *-- MemoryBookRepository
    SqliteBookRepository --> BookRowMapper
    MemoryBookRepository --> BookRowMapper

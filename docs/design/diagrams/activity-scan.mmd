%%{init: {"flowchart": {"rankSpacing": 22, "nodeSpacing": 28, "diagramPadding": 4}}}%%
flowchart TD
    start((Start)) --> input{Camera<br/>allowed?}
    input -- yes --> camera[Scan the barcode]
    input -- no --> typed[Type the ISBN]
    camera --> valid{Valid<br/>ISBN?}
    typed --> valid
    valid -- no --> invalid[Show 'not a<br/>valid ISBN'] --> end1((End))
    valid -- yes --> lookup[Look up in Google Books<br/>+ Open Library]
    lookup --> found{Edition<br/>found?}
    found -- no --> err[Show 'no book<br/>found'] --> end2((End))
    found -- yes --> dup{Already in<br/>library?}
    dup -- yes --> copy[Confirm: add<br/>another copy] --> save[Save the book] --> end3((End))
    dup -- no --> next((A))

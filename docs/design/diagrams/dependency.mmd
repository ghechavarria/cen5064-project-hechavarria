flowchart LR
    App["App.tsx"] --> Root["CompositionRoot<br/>(bootstrap.ts)"]
    App --> Model["LibraryAppModel"]
    Model --> Controller["LibraryController"]
    Model --> Family["DeviceFamily «interface»<br/>CoverCamera · Feedback"]
    Devices["PhoneDevices / BrowserDevices"] -. implements .-> Family
    App -- picks one --> Devices
    Controller --> UC["UseCases"]
    UC --> Domain["Domain<br/>Book · PersonalLibrary ·<br/>AcquisitionRecord"]
    UC --> Ports["Ports «interfaces»<br/>BookRepository · IsbnLookup"]
    Repos["SqliteBookRepository<br/>JsonBookRepository"] -. implements .-> Ports
    Lookups["CachingIsbnLookup → MergedIsbnLookup →<br/>OpenLibrary + GoogleBooks"] -. implements .-> Ports
    Root --> UC
    Root --> Repos
    Root --> Lookups
    Lookups --> Http["Http"]
    Repos --> Mapper["BookRowMapper"]
    Mapper --> Domain
